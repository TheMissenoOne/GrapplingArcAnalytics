[Unit]
Description=Publish GrapplingArc weekly technique-study digests (Pro)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/vetor/GrapplingArc/GrapplingArcAnalytics
EnvironmentFile=%h/GrapplingArc/GrapplingArcAnalytics/.env
ExecStart=/home/vetor/.local/bin/uv run --extra postgres python -m jobs.publish_technique_studies
