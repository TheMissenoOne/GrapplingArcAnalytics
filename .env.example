# Kaggle API — required for dataset download
# Get your API key at: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Roboflow API — optional, for BJJ3 dataset exploration
ROBOFLOW_API_KEY=your_roboflow_api_key

# ViCoS dataset download URL (stable)
VICOS_DOWNLOAD_BASE=https://vicos.si/resources/jiujitsu/

# Logging
LOG_LEVEL=INFO

# Postgres connection for db/base.py (admin dashboard, ontology, athlete graphs).
# postgresql://user:password@host:port/dbname — see docs/ for a Supabase pooler URL.
DATABASE_URL=postgresql://user:password@localhost:5432/grapplingarc

# Supabase project (server-side admin + publisher). Get these from
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Admin dashboard (admin/auth.py) — REQUIRED, no insecure default. Generate with:
#   python -m admin.auth --hash
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt_b64>$<hash_b64>

# Admin session cookie Secure flag. Defaults to true (HTTPS only) — set false only
# for local plain-HTTP development, never in production.
ADMIN_COOKIE_SECURE=true

# NOTE: login rate limiting (admin/auth.py) keys off request.client.host. Behind a
# reverse proxy that terminates HTTPS (which ADMIN_COOKIE_SECURE=true implies),
# every request arrives from the proxy's IP — 5 failed logins from anyone would
# lock out every admin at once. If a proxy sits in front of this, it needs to
# forward the real client IP (X-Forwarded-For) and the app needs to read it,
# which it does not do today.
