# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg

# Environment
.env
.env.local

# Local database
db.sqlite
*.sqlite

# Data (downloaded datasets — large, not committed)
data/raw/*
data/processed/*
data/captures/
data/study/reports/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Vision dataset (scripts/vision_dataset.py) — frames + labels are large and fully
# regenerable from the sheet PDFs. The manifest, the split and the card are small,
# are what make a measurement citable, and ARE committed.
data/finetune/*
!data/finetune/manifests/
!data/finetune/splits/
!data/finetune/DATASET_CARD.md

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ML models (too large)
*.joblib
*.pkl
*.h5
*.pt
*.onnx

# ViCoS dataset
cv/vicos_data/
cv/images/

# Obsidian vault (kanban/) — track only stable config
kanban/.obsidian/*
!kanban/.obsidian/app.json
!kanban/.obsidian/graph.json
!kanban/.obsidian/core-plugins.json
!kanban/.obsidian/community-plugins.json
!kanban/.obsidian/types.json
!kanban/.obsidian/templates.json

# GrappleMap full icon render (CV-derived bulk; regenerate via export/grapplemap_icons_export.py)
data/grapplemap_icons/

# Raw transcripts + root match dumps (source corpus, large; see TRANSCRIPT_PROCESSING.md)
transcripts/
.export_cache/
reports/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
data/external/

# ── CV decision-vision ────────────────────────────────────────────────
# Track the SOURCE (poc/, tests/poc/) and the FINDINGS. Never the pixels or
# the weights: `data/cv_decision_poc/` is ~117MB, of which ~86MB is trained
# model artifacts and ~27MB is audit frames that `poc/decision_vision/
# audit_frames.py` regenerates from a match id + window. What deserves history
# is the conclusion (vision_audit.md, report.json, progress.json) and the
# sampled timelines the audit cites, not the images it looked at.
data/cv_decision_poc/**
!data/cv_decision_poc/**/
!data/cv_decision_poc/**/*.md
!data/cv_decision_poc/**/report.json
!data/cv_decision_poc/**/progress.json
!data/cv_decision_poc/**/*.csv
# …but never these, regardless of extension:
data/cv_decision_poc/model/**
data/cv_decision_poc/model_probe/**

# Raw caption transcripts — same policy as transcripts/: third-party text,
# regenerable from the video, paired prompts in docs/prompts/ are what matter.
docs/raw/

# frame_pdf.py output — contact sheets are regenerable from data/frame_pdf/*.json and
# each one is megabytes of JPEG. The manifest is the artefact worth versioning, not the PDF.
data/frame_pdf/out/
data/frame_pdf/trials_2023_24/*.pdf
data/frame_pdf/trials_2023_24/pendentes_gemini/
data/frame_pdf/gemini_baseline/

# owner training footage — private, never committed
data/video/

# Next-move experiment caches — regenerable (corpus re-pulled from the DB, vectors re-embedded).
# The report itself (eval.csv / eval_meta.json) IS committed.
data/next_moves/corpus.json
data/next_moves/emb_cache.json
